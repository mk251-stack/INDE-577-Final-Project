# =====================================================
# Python / Byte-compiled files
# =====================================================
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so


# =====================================================
# Virtual environments
# =====================================================
.venv/
venv/
env/
ENV/
*.env
*.venv


# =====================================================
# Distribution / packaging
# =====================================================
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg


# =====================================================
# Installer logs
# =====================================================
pip-log.txt
pip-delete-this-directory.txt


# =====================================================
# Unit test / coverage reports
# =====================================================
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/


# =====================================================
# Pytest / type checker / lint caches
# =====================================================
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/


# =====================================================
# Jupyter Notebook artifacts
# =====================================================
.ipynb_checkpoints
**/*.ipynb_checkpoints
*_files/


# =====================================================
# IDE / OS files
# =====================================================
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db


# =====================================================
# Model files (large, should not be committed)
# =====================================================
*.pkl
*.joblib
models/


# =====================================================
# Raw dataset formats (ignored by default)
# =====================================================
*.csv
*.tsv
*.zip
*.gz
*.tar
*.tar.gz
*.rar
*.npy
*.npz
*.pickle
*.pt
*.pth
*.h5
*.hdf5


# =====================================================
# Datasets directory rules
# =====================================================
# Ignore everything in datasets by default
datasets/*

# Allowlist: curated small datasets
!datasets/BostonHousing.csv
!datasets/UCI_Credit_Card.csv
!datasets/energy.csv

# Allowlist: Fashion-MNIST (small binary IDX files)
!datasets/FashionMNIST/**
!datasets/FashionMNIST/raw/*idx*

# Allow documentation and reproducibility scripts
!datasets/README.md
!datasets/merge.py
