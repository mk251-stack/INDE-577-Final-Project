# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
*.env
*.venv

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/

# Pytest cache
.pytest_cache/

# MyPy / type checker
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff / lint cache
.ruff_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
**/*.ipynb_checkpoints

# nbconvert output image folders
*_files/

# VS Code
.vscode/

# MacOS / Windows system files
.DS_Store
Thumbs.db

# Local IDE / project settings
.idea/
*.iml

# Model files (very large, should never be committed)
*.pkl
*.joblib
models/

# Prevent accidentally committing intermediate notebook output
**/*.ipynb_checkpoints

# Ignore raw dataset formats commonly >100 MB
*.csv
*.tsv
*.zip
*.gz
*.tar
*.tar.gz
*.rar

# Ignore numpy and pickle dataset dumps
*.npy
*.npz
*.pkl
*.pickle

# Ignore raw torch/tf dataset files except Fashion-MNIST idx
# (which is safe and small)
*.pt
*.pth
*.h5
*.hdf5

# Allowlist Fashion-MNIST IDX files
!datasets/FashionMNIST/raw/*idx*

# Ignore any file larger than 10 MB (git attribute)
*.big

# Optional: ignore anything inside datasets/ except small allowed files
datasets/*

# Allowlist for curated small datasets
!datasets/BostonHousing.csv
!datasets/UCI_Credit_Card.csv
!datasets/FashionMNIST/**
*_files/
